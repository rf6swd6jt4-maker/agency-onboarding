NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=betelgeze
R2_PUBLIC_BASE_URL=
SUNBIZ_SHARD_BASE_URL=
AZ_OWNER_SHARD_BASE_URL=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
SYSTEM_HEALTH_SUPABASE_DATABASE_LIMIT_MB=500
VERCEL_API_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=

FOURSQUARE_OS_PLACES_PMTILES_URL=
SAM_GOV_API_KEY=

LEADGEN_NER_ENABLED=false
LEADGEN_NER_ENDPOINT=
LEADGEN_NER_TOKEN=
LEADGEN_NER_TIMEOUT_MS=1800
LEADGEN_NER_REQUIRE_WEAK_WEBSITE=true
LEADGEN_SUNBIZ_IMPORT_SECRET=

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Standard Web Push VAPID credentials. Keep the private key server-only.
WEB_PUSH_VAPID_SUBJECT=mailto:support@betelgeze.com
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=

# Transactional email (workspace invitations)
RESEND_API_KEY=
EMAIL_FROM=Betelgeze <noreply@betelgeze.com>
EMAIL_REPLY_TO=hello@betelgeze.com
SEND_EMAIL_HOOK_SECRET=
RESEND_WEBHOOK_SECRET=
# Keep disabled until the account-system migration, auth host, Supabase hook,
# redirect allowlist, and Resend webhook have all been verified.
ACCOUNT_FLOW_V2_ENABLED=false

# Workspace-owned provider connections. Keep every server-side value secret.
WORKSPACE_INTEGRATION_ENCRYPTION_KEY=
WORKSPACE_CONNECTIONS_FORCE_LEGACY=false
STRIPE_APP_OAUTH_CLIENT_ID=
STRIPE_APP_LIVE_AUTHORIZE_URL=
STRIPE_APP_TEST_AUTHORIZE_URL=
STRIPE_APP_LIVE_SECRET_KEY=
STRIPE_APP_TEST_SECRET_KEY=
# Stripe creates separate signing secrets for test and live App event destinations.
STRIPE_APP_TEST_WEBHOOK_SECRET=
STRIPE_APP_LIVE_WEBHOOK_SECRET=
# Deprecated compatibility fallback for deployments configured before split destinations.
STRIPE_APP_WEBHOOK_SECRET=
NEXT_PUBLIC_META_APP_ID=
NEXT_PUBLIC_META_EMBEDDED_SIGNUP_CONFIG_ID=
META_APP_SECRET=
META_WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Onboarding delivery-plan cutover:
# - versioned (default): freeze and deliver the published Settings configuration.
# - shadow: deliver the hard-coded legacy plan and record a sanitized comparison.
# - legacy: deliver the hard-coded legacy plan without shadow comparison.
# Settings authoring remains enabled in every mode. Existing frozen invoices
# always resume their versioned snapshot even after a runtime rollback.
ONBOARDING_RUNTIME_MODE=versioned

# Required by the external cron-job.org onboarding outbox scheduler. Configure
# the same value as its custom `Authorization: Bearer <value>` request header.
# Do not add a frequent Vercel Cron schedule: Hobby only supports daily runs.
# Calls fail closed when this value is unset or the request header is wrong.
CRON_SECRET=

CLICKUP_API_TOKEN=
CLICKUP_WORKSPACE_ID=
CLICKUP_CLIENTS_SPACE_ID=
CLICKUP_CLIENT_FOLDER_TEMPLATE_ID=
